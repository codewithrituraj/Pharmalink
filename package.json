{
  "name": "pharmalink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 4321 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 4321 --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-timeout=180000 \"tests/integration/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "postinstall": "prisma skills sync || exit 0",
    "jobs:run": "tsx scripts/jobs-run.ts",
    "jobs:daemon": "tsx scripts/jobs-daemon.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
