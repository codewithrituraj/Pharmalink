generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  password       String
  role           String // ADMIN, MANUFACTURER, STOCKIST
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  favourites     Favourite[]
  isSuspended    Boolean       @default(false)
  auditEvents    AuditLog[]    @relation("ActorAuditEvents")
  paymentReviews PaymentSubmission[] @relation("PaymentReviewer")
}

model Organization {
  id                 String           @id @default(cuid())
  name               String
  type               String // MANUFACTURER, STOCKIST
  drugLicense        String?
  gstNumber          String?
  region             String?
  address            String?
  verificationRemark String?
  documents          VerificationDocument[]
  status             String           @default("PENDING") // PENDING, REVIEW, VERIFIED, REJECTED
  users              User[]
  products           Product[]
  grantedAccess      AccessGrant[]    @relation("ManufacturerGrants")
  receivedAccess     AccessGrant[]    @relation("StockistGrants")
  ordersPlaced       Order[]          @relation("BuyerOrders")
  ordersReceived     Order[]          @relation("SellerOrders")
  notifications      Notification[]
  stockistDrafts     CartDraft[]      @relation("StockistDrafts")
  manufacturerDrafts CartDraft[]      @relation("ManufacturerDrafts")
  inventoryBatches   InventoryBatch[]
  demandSamples      DemandSample[]
  jobRuns            JobRun[]
  auditEvents        AuditLog[] @relation("OrganizationAuditEvents")
  returnRequests     ReturnRequest[] @relation("BuyerReturns")
  returnsReceived    ReturnRequest[] @relation("SellerReturns")
  complianceViolations ProductPriceViolation[] @relation("ViolationManufacturer")
  h1RegisterEntries H1RegisterEntry[] @relation("H1RegisterBuyer")
  traceVerifications TraceVerificationLog[] @relation("TraceStockist")
  marketplaceListings MarketplaceListing[] @relation("ListingSeller")
  swapOrdersAsBuyer SwapOrder[] @relation("SwapBuyer")
  swapOrdersAsSeller SwapOrder[] @relation("SwapSeller")
  paymentSubmissionsAsStockist PaymentSubmission[] @relation("PaymentStockist")
  paymentSubmissionsAsManufacturer PaymentSubmission[] @relation("PaymentManufacturer")
}

model AccessGrant {
  id             String       @id @default(cuid())
  manufacturerId String
  stockistId     String
  status         String       @default("PENDING") // PENDING, VERIFIED, REJECTED
  message        String?
  requestedAt    DateTime     @default(now())
  decidedAt      DateTime?
  customDiscount Float?
  manufacturer   Organization @relation("ManufacturerGrants", fields: [manufacturerId], references: [id])
  stockist       Organization @relation("StockistGrants", fields: [stockistId], references: [id])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  type           String // ORDER_PLACED, ORDER_STATUS, ACCESS_REQUEST, ACCESS_DECISION, LOW_STOCK, EXPIRY, SCHEME
  title          String
  message        String
  severity       String       @default("INFO") // INFO, WARNING, CRITICAL
  link           String?
  dedupeKey      String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
}

model Product {
  id               String           @id @default(cuid())
  manufacturerId   String
  name             String
  genericName      String
  composition      String           @default("")
  category         String           @default("General")
  dosageForm       String           @default("Tablet")
  strength         String           @default("")
  packSize         String           @default("10 x 10")
  gstPercent       Float            @default(12)
  isPrescription   Boolean          @default(false)
  isScheduleH1     Boolean          @default(false)
  requiresColdChain Boolean         @default(false)
  storage          String           @default("Store below 25 C")
  minOrderQty      Int              @default(1)
  leadTimeDays     Int              @default(7)
  mrp              Float
  ptr              Float
  pts              Float
  isActive         Boolean          @default(true)
  availability     Int              @default(0)
  imageUrl         String?
  hsnCode          String           @default("3004")
  batches          Batch[]
  schemes          Scheme[]
  manufacturer     Organization     @relation(fields: [manufacturerId], references: [id])
  orderItems       OrderItem[]
  favourites       Favourite[]
  draftItems       CartDraftItem[]
  inventoryBatches InventoryBatch[]
  demandSamples    DemandSample[]
  returnItems      ReturnItem[]
  complianceViolations ProductPriceViolation[]
  h1RegisterEntries H1RegisterEntry[]
  marketplaceListings MarketplaceListing[]
  swapOrders       SwapOrder[]
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Scheme {
  id              String   @id @default(cuid())
  productId       String
  name            String
  type            String // SLAB_DISCOUNT, FREE_GOODS
  minQuantity     Int      @default(1)
  discountPercent Float    @default(0)
  freeQuantity    Int      @default(0)
  stockistId      String?
  validFrom       DateTime
  validUntil      DateTime
  product         Product  @relation(fields: [productId], references: [id])
}

model Batch {
  id          String                @id @default(cuid())
  productId   String
  batchNumber String
  quantity    Int
  mfgDate     DateTime
  expiryDate  DateTime
  qrCode      String?               @unique
  product     Product               @relation(fields: [productId], references: [id])
  allocations OrderItemAllocation[]
  traceLogs   TraceVerificationLog[]
}

model InventoryBatch {
  id            String       @id @default(cuid())
  stockistId    String
  productId     String
  batchNumber   String
  quantity      Int
  mfgDate       DateTime?
  expiryDate    DateTime
  receivedAt    DateTime     @default(now())
  sourceOrderId String?
  stockist      Organization @relation(fields: [stockistId], references: [id])
  product       Product      @relation(fields: [productId], references: [id])
  sourceOrder   Order?       @relation(fields: [sourceOrderId], references: [id])
  returnItems   ReturnItem[]
  marketplaceListings MarketplaceListing[]

  @@index([stockistId, productId])
  @@index([stockistId, expiryDate])
}

model DemandSample {
  id          String       @id @default(cuid())
  stockistId  String
  productId   String
  periodStart DateTime
  quantity    Int
  source      String       @default("ORDER")
  stockist    Organization @relation(fields: [stockistId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])

  @@unique([stockistId, productId, periodStart])
}

model Order {
  id               String           @id @default(cuid())
  buyerId          String
  sellerId         String
  status           String           @default("PLACED") // PLACED, APPROVED, PACKED, DISPATCHED, DELIVERED, REJECTED, CANCELLED
  subtotal         Float            @default(0)
  discount         Float            @default(0)
  gst              Float            @default(0)
  total            Float
  notes            String?
  transporter      String?
  trackingNumber   String?
  expectedDelivery DateTime?
  invoiceNumber    String?
  invoiceCreatedAt DateTime?
  poNumber         String?
  isPaid           Boolean          @default(false)
  paidAt           DateTime?
  paymentRef       String?
  paymentStatus    String           @default("UNPAID") // UNPAID, SUBMITTED, PARTIALLY_PAID, PAID, REJECTED
  paidAmount       Float            @default(0)
  createdAt        DateTime         @default(now())
  items            OrderItem[]
  audits           OrderAudit[]
  inventoryBatches InventoryBatch[]
  returnRequests   ReturnRequest[]
  h1RegisterEntries H1RegisterEntry[]
  traceVerifications TraceVerificationLog[]
  paymentSubmissions PaymentSubmission[]
  buyer            Organization     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller           Organization     @relation("SellerOrders", fields: [sellerId], references: [id])
}

model OrderAudit {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

model CartDraft {
  id             String          @id @default(cuid())
  stockistId     String
  manufacturerId String
  notes          String?
  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())
  items          CartDraftItem[]
  stockist       Organization    @relation("StockistDrafts", fields: [stockistId], references: [id])
  manufacturer   Organization    @relation("ManufacturerDrafts", fields: [manufacturerId], references: [id])
}

model CartDraftItem {
  id        String    @id @default(cuid())
  draftId   String
  productId String
  quantity  Int
  draft     CartDraft @relation(fields: [draftId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
}

model OrderItem {
  id          String                @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  price       Float
  freeQuantity Int                  @default(0)
  order       Order                 @relation(fields: [orderId], references: [id])
  product     Product               @relation(fields: [productId], references: [id])
  allocations OrderItemAllocation[]
  h1RegisterEntry H1RegisterEntry?
}

model OrderItemAllocation {
  id          String    @id @default(cuid())
  orderItemId String
  batchId     String
  quantity    Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  batch       Batch     @relation(fields: [batchId], references: [id])

  @@unique([orderItemId, batchId])
}

model JobRun {
  id                   String        @id @default(cuid())
  job                  String
  status               String        @default("RUNNING") // RUNNING, SUCCESS, FAILED
  trigger              String        @default("SCHEDULE") // SCHEDULE, MANUAL, SEED
  notificationsCreated Int           @default(0)
  notificationsSkipped Int           @default(0)
  summary              String?
  error                String?
  startedAt            DateTime      @default(now())
  finishedAt           DateTime?
  organization         Organization? @relation(fields: [organizationId], references: [id])

  organizationId String?

  @@index([job, startedAt])
}

model VerificationDocument {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  mimeType       String
  size           Int
  path           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  detail         String?
  createdAt      DateTime      @default(now())
  actor          User?         @relation("ActorAuditEvents", fields: [actorId], references: [id])
  organization   Organization? @relation("OrganizationAuditEvents", fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String?
  buyerId     String
  sellerId    String
  reason      String
  status      String       @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, CREDITED
  remark      String?
  creditNote  String?
  creditNoteCreatedAt DateTime?
  total       Float        @default(0)
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?
  order       Order?       @relation(fields: [orderId], references: [id])
  buyer       Organization @relation("BuyerReturns", fields: [buyerId], references: [id])
  seller      Organization @relation("SellerReturns", fields: [sellerId], references: [id])
  items       ReturnItem[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  inventoryBatchId String?
  productId       String
  quantity        Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id])
  inventoryBatch  InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model NppaCeilingPrice {
  id            String                 @id @default(cuid())
  drugName      String
  composition   String
  packSize      String
  ceilingPrice  Float
  effectiveDate DateTime
  createdAt     DateTime               @default(now())
  violations    ProductPriceViolation[]

  @@unique([composition, packSize, effectiveDate])
  @@index([composition, packSize, effectiveDate])
}

model ProductPriceViolation {
  id             String           @id @default(cuid())
  productId      String
  manufacturerId String
  referenceId    String
  submittedMrp   Float
  ceilingPrice   Float
  detectedAt     DateTime         @default(now())
  resolvedAt     DateTime?
  active         Boolean          @default(true)
  product        Product          @relation(fields: [productId], references: [id])
  manufacturer   Organization     @relation("ViolationManufacturer", fields: [manufacturerId], references: [id])
  reference      NppaCeilingPrice @relation(fields: [referenceId], references: [id])

  @@unique([productId, referenceId])
  @@index([active, detectedAt])
}

model H1RegisterEntry {
  id                           String       @id @default(cuid())
  orderId                      String
  orderItemId                  String       @unique
  productId                    String
  buyerId                      String
  buyerName                    String
  patientName                  String
  prescriberName               String
  prescriberRegistrationNumber String
  quantity                     Int
  createdAt                    DateTime     @default(now())
  order                        Order        @relation(fields: [orderId], references: [id])
  orderItem                    OrderItem    @relation(fields: [orderItemId], references: [id])
  product                      Product      @relation(fields: [productId], references: [id])
  buyer                        Organization @relation("H1RegisterBuyer", fields: [buyerId], references: [id])

  @@index([createdAt, productId])
  @@index([buyerId, createdAt])
}

model TraceVerificationLog {
  id            String       @id @default(cuid())
  stockistId    String
  orderId       String
  batchId       String?
  submittedCode String
  matched       Boolean
  details       String?
  createdAt     DateTime     @default(now())
  stockist      Organization @relation("TraceStockist", fields: [stockistId], references: [id])
  order         Order        @relation(fields: [orderId], references: [id])
  batch         Batch?       @relation(fields: [batchId], references: [id])

  @@index([orderId, createdAt])
  @@index([matched, createdAt])
}

model MarketplaceListing {
  id               String          @id @default(cuid())
  sellerId         String
  inventoryBatchId String
  productId        String
  quantity         Int
  pricePerUnit     Float
  status           String          @default("ACTIVE") // ACTIVE, EXHAUSTED, DELISTED, EXPIRED
  expiresAt        DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  seller           Organization    @relation("ListingSeller", fields: [sellerId], references: [id])
  inventoryBatch   InventoryBatch  @relation(fields: [inventoryBatchId], references: [id])
  product          Product         @relation(fields: [productId], references: [id])
  orders           SwapOrder[]

  @@index([status, expiresAt])
  @@index([sellerId, status])
}

model SwapOrder {
  id           String            @id @default(cuid())
  listingId    String
  buyerId      String
  sellerId     String
  productId    String
  quantity     Int
  pricePerUnit Float
  total        Float
  status       String            @default("ORDERED") // ORDERED, SHIPPED, DELIVERED, CANCELLED
  createdAt    DateTime          @default(now())
  shippedAt    DateTime?
  deliveredAt  DateTime?
  listing      MarketplaceListing @relation(fields: [listingId], references: [id])
  buyer        Organization      @relation("SwapBuyer", fields: [buyerId], references: [id])
  seller       Organization      @relation("SwapSeller", fields: [sellerId], references: [id])
  product      Product           @relation(fields: [productId], references: [id])

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

model PaymentSubmission {
  id             String       @id @default(cuid())
  orderId        String
  stockistId     String
  manufacturerId String
  amount         Float
  reference      String
  status         String       @default("SUBMITTED") // SUBMITTED, CONFIRMED, REJECTED
  submittedAt    DateTime     @default(now())
  reviewedAt     DateTime?
  reviewerUserId String?
  reviewNote     String?
  order          Order        @relation(fields: [orderId], references: [id])
  stockist       Organization @relation("PaymentStockist", fields: [stockistId], references: [id])
  manufacturer   Organization @relation("PaymentManufacturer", fields: [manufacturerId], references: [id])
  reviewer       User?        @relation("PaymentReviewer", fields: [reviewerUserId], references: [id])

  @@index([manufacturerId, status, submittedAt])
  @@index([stockistId, submittedAt])
}
